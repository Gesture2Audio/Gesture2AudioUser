{
  "project": "GreenAR-inspired browser soundscape generator",
  "method": [
    "Compose a soundscape from user-selected natural sound objects.",
    "Treat each selected object as a small cluster of spatialized voices rather than one static loop.",
    "Randomize loop start, playback rate, gain, stereo/panner position, filter frequency, and event timing to avoid repetition.",
    "Apply mood as a master mix layer that changes density, brightness, tempo, reverb, and per-source balance.",
    "Measure each decoded local recording and apply automatic loudness normalization so quiet chirps and louder water beds sit in the same mix.",
    "Load one local sample per icon and use randomized loop windows, playback rate, gain, pan, and filter settings for realism."
  ],
  "sampleLibrary": {
    "file": "data/sample-library.json",
    "provider": "Local six-sample prototype set",
    "samplesPerCategory": 1
